# GEMINI_API_KEY: Required on the Express backend server for Gemini AI conversation, TTS, and vision.
# Never expose this key in frontend VITE_ variables or commit real keys to Git.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS URL where the Express backend is hosted (e.g., Cloud Run URL).
# Used for CORS, self-referential links, and packaged client routing.
APP_URL="https://your-alya-backend.run.app"

# VITE_API_BASE_URL: Optional build-time HTTPS backend base URL for packaged Android APK / Capacitor builds.
# Leave empty when serving web and API from the same origin, or set to your deployed backend URL before running `npm run cap:sync`.
VITE_API_BASE_URL=""
